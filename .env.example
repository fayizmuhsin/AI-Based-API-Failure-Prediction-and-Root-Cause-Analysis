APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_API_PREFIX=/api
APP_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
APP_SERVICE_CONFIG_PATH=config/services.json
APP_APPLICATION_DATABASE_PATH=data/simulated/application.db
APP_MONITORING_DATABASE_PATH=data/monitoring/monitoring.db

# Phase 2 simulated services. Start each process in its own PowerShell window.
API_GATEWAY_PORT=8100
USER_SERVICE_PORT=8101
ORDER_SERVICE_PORT=8102
DATABASE_SERVICE_PORT=8103
USER_SERVICE_URL=http://127.0.0.1:8101
ORDER_SERVICE_URL=http://127.0.0.1:8102
DATABASE_SERVICE_URL=http://127.0.0.1:8103

# Phase 3 best-effort telemetry delivery from simulated services.
TELEMETRY_INGEST_URL=http://127.0.0.1:8000/api/telemetry/ingest

# Phase 5 anomaly detection. Isolation Forest trains only through the explicit
# training command after enough threshold-clean observed windows are available.
APP_ANOMALY_CONTAMINATION=0.05
APP_ANOMALY_RANDOM_STATE=42
APP_ANOMALY_MIN_TRAINING_SAMPLES=30
APP_ANOMALY_MIN_TRAINING_REQUESTS=5
APP_ANOMALY_DETECTION_BATCH_SIZE=100
APP_ANOMALY_WINDOW_LATENESS_SECONDS=10
APP_ANOMALY_RULE_MIN_REQUESTS=5
APP_ANOMALY_ERROR_RATE_THRESHOLD=0.25
APP_ANOMALY_P95_LATENCY_THRESHOLD_MS=1000
APP_ANOMALY_TIMEOUT_COUNT_THRESHOLD=2
APP_ANOMALY_LATENCY_SPIKE_RATIO=2.5
APP_ANOMALY_LATENCY_SPIKE_MIN_HISTORY=3
APP_ANOMALY_DEPENDENCY_FAILURE_RATE_THRESHOLD=0.3
APP_ANOMALY_REQUEST_CHANGE_RATIO=3

# Phase 6 RCA processing and evidence threshold.
APP_RCA_CORRELATION_WINDOW_SECONDS=180
APP_RCA_PROCESSING_BATCH_SIZE=100
APP_RCA_CANDIDATE_MIN_SCORE=30
